{
  "name": "max-hackathon-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run api:generate",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run api:generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "node scripts/generate-api.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@maxhub/max-ui": "0.5.0",
    "@vkontakte/icons": "^3.0.0",
    "@vkontakte/vkui": "^8.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "swagger-typescript-api": "13.12.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
